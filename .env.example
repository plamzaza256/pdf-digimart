# ค่าตัวอย่าง — คัดลอกเป็นไฟล์ .env.local (ไฟล์นี้ไม่ถูก commit ขึ้น Git)
# วิธีหาค่า: Firebase Console → ⚙️ Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=PASTE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID
VITE_FIREBASE_APP_ID=PASTE_APP_ID

# ค่านี้ไม่ต้องใส่ในเว็บ — ใส่ใน Apps Script แทน
# Script properties ชื่อ FIREBASE_PROJECT_ID ต้องมีค่าเดียวกับ VITE_FIREBASE_PROJECT_ID